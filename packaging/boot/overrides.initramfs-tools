#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
PREREQ=""
prereqs() { echo "$PREREQ"; }
case ${1:-} in prereqs) prereqs; exit 0;; esac
# shellcheck source=/dev/null
. /usr/share/initramfs-tools/hook-functions
copy_exec /usr/lib/gpu-unlock/prepare-overrides
copy_exec /usr/lib/gpu-unlock/apply-procfs-override
mkdir -p "$DESTDIR/usr/lib/modprobe.d"
cp /usr/lib/modprobe.d/gpu-unlock.conf "$DESTDIR/usr/lib/modprobe.d/"
# version is supplied by initramfs-tools.
# shellcheck disable=SC2154
/usr/lib/gpu-unlock/prepare-overrides --driver-mode "$version" > "$DESTDIR/usr/lib/gpu-unlock/driver-mode"
for binary in modprobe modinfo mkdir ln rm grep cat; do
    copy_exec "$(command -v "$binary")"
done
mkdir -p "$DESTDIR/usr/lib/firmware/nvidia"
ln -s /sys/kernel/gpu_unlock/overrides "$DESTDIR/usr/lib/firmware/nvidia/gpu-unlock"
